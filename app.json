{
  "expo": {
    "name": "Ahaan Eye",
    "slug": "ahaan-eye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ahaaneye",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7C7B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahaaneye.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ahaan Eye uses Face ID to unlock your medication history.",
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C7B"
      },
      "package": "com.ahaaneye.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E7C7B"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E7C7B",
          "defaultChannel": "dose-reminders"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ahaan Eye uses Face ID to unlock your medication history."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
